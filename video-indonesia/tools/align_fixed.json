, jutaan tahun setelah"}, {"i": 120, "ts": "9:44", "t": 584.24, "score": 3, "heard": " Sungai  masih  mengalir.  Gunung", "nar": "Sungai masih mengalir, gunung-gunung"}, {"i": 121, "ts": "9:48", "t": 588.12, "score": 3, "heard": " Namun,  dunia  di  sekitarnya", "nar": "Namun, dunia di sekitarnya"}, {"i": 122, "ts": "9:52", "t": 591.88, "score": 3, "heard": " Kita  memiliki  kendaraan,  rumah,", "nar": "Kita memiliki kendaraan, rumah,"}, {"i": 123, "ts": "10:01", "t": 600.26, "score": 3, "heard": " Tetapi  semua  kemudahan  itu", "nar": "Tetapi, semua kemudahan itu"}, {"i": 124, "ts": "10:06", "t": 605.68, "score": 3, "heard": " Jauh  sebelum  Indonesia  memiliki", "nar": "Jauh sebelum Indonesia memiliki"}, {"i": 125, "ts": "10:15", "t": 614.84, "score": 3, "heard": " Mereka  tidak  meninggalkan  tulisan", "nar": "Mereka tidak meninggalkan tulisan"}, {"i": 126, "ts": "10:18", "t": 618.3, "score": 3, "heard": " Mereka  meninggalkan  fosil,  peralatan", "nar": "Mereka meninggalkan fosil, peralatan"}, {"i": 127, "ts": "10:25", "t": 624.28, "score": 3, "heard": " Dan  mungkin,  hal  paling", "nar": "Dan mungkin, hal paling"}, {"i": 128, "ts": "10:33", "t": 633.22, "score": 2, "heard": " Melayinkan  kenyataan  bahwa  manusia", "nar": "Melainkan kenyataan bahwa manusia"}]