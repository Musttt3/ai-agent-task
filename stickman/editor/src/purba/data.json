"shots": [
{
"n": 1,
"file": "01.jpg",
"text": "Minus 30 derajat, tanpa jaket, tanpa sepatu modern.",
"from": 0,
"dur": 154
},
{
"n": 2,
"file": "02.jpg",
"text": "Apakah manusia purba bisa selamat?",
"from": 154,
"dur": 78
},
{
"n": 3,
"file": "03.jpg",
"text": "Jawabannya bisa, tapi tidak mudah.",
"from": 232,
"dur": 121
},
{
"n": 4,
"file": "04.jpg",
"text": "Manusia purba tidak bertahan sendirian melawan dingin.",
"from": 353,
"dur": 108
},
{
"n": 5,
"file": "05.jpg",
"text": "Mereka memakai kulit hewan tebal,",
"from": 461,
"dur": 72
},
{
"n": 6,
"file": "06.jpg",
"text": "tinggal di gua atau tempat berlindung sederhana,",
"from": 533,
"dur": 86
},
{
"n": 7,
"file": "07.jpg",
"text": "lalu menjaga api tetap menyala siang dan malam.",
"from": 619,
"dur": 111
},
{
"n": 8,
"file": "08.jpg",
"text": "Mereka juga makan makanan berlemak dan tinggi energi supaya tubuh tetap panas.",
"from": 730,
"dur": 166
},
{
"n": 9,
"file": "09.jpg",
"text": "Di tempat bersalju, mereka bergerak dalam kelompok,",
"from": 896,
"dur": 99
},
{
"n": 10,
"file": "10.jpg",
"text": "saling menghangatkan dan menghindari terlalu lama diam di luar.",
"from": 995,
"dur": 135
},
{
"n": 11,
"file": "11.jpg",
"text": "Tapi kalau api padam,",
"from": 1130,
"dur": 53
},
{
"n": 12,
"file": "12.jpg",
"text": "pakaian basah,",
"from": 1183,
"dur": 43
},
{
"n": 13,
"file": "13.jpg",
"text": "atau mereka terpisah dari kelompok,",
"from": 1226,
"dur": 75
},
{
"n": 14,
"file": "14.jpg",
"text": "suhu minus 30 derajat bisa membunuh dalam waktu singkat.",
"from": 1301,
"dur": 130
},
{
"n": 15,
"file": "15.jpg",
"text": "Jadi, manusia purba memang bisa bertahan di cuaca ekstrim,",
"from": 1431,
"dur": 133
},
{
"n": 16,
"file": "16.jpg",
"text": "tapi kuncinya cuma tiga, api,",
"from": 1564,
"dur": 98
},
{
"n": 17,
"file": "17.jpg",
"text": "perlindungan,",
"from": 1662,
"dur": 21
},
{
"n": 18,
"file": "18.jpg",
"text": "dan kebersamaan.",
"from": 1683,
"dur": 63
}
],
